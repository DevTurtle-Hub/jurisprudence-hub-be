# ==============================================================
# JURISPRUDENCE HUB BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# Sao chep tep nay thanh .env de cau hinh bien moi truong local hoac production
# ==============================================================

# 1. SERVER
PORT=8080
CONTEXT_PATH=/

# 2. DATABASE (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/jurisprudence_hub
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password
DB_POOL_MAX=10
DB_POOL_MIN=2

# 3. JWT SECURITY (Chuoi bi mat bat buoc dai >= 32 ky tu tren production)
JWT_SECRET=your_production_jwt_secret_key_at_least_32_characters_long

# 4. CORS (Danh sach origin frontend, cach nhau boi dau phay)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# 5. EXAM HMAC SECRET
EXAM_HMAC_SECRET=your_production_exam_hmac_secret_key_2026

# 6. DEFAULT ADMIN ACCOUNT (Tuy chon)
APP_ADMIN_ENABLED=true
APP_ADMIN_EMAIL=admin@gmail.com
APP_ADMIN_PASSWORD=admin123
APP_ADMIN_NAME=Quản Trị Viên CAND
APP_ADMIN_UNIT=Cục Đào tạo - Bộ Công An

# 7. FLYWAY
FLYWAY_ENABLED=true
FLYWAY_CLEAN_DISABLED=true
