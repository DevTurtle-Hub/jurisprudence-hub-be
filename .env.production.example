# ==============================================================================
# JURISPRUDENCE HUB BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Sao chep tep nay thanh .env.production hoac cau hinh truc tiep tren Jenkins Credentials.
# LUY Y: Khong commit cac mat khau that len Git!
# ==============================================================================

# 1. APPLICATION & PORTS
HOST_PORT=8081
PORT=8080
DB_PORT=5432
DOCKER_IMAGE=jurisprudence-backend
BUILD_TAG=latest

# 2. DATABASE CONFIGURATION (PostgreSQL)
POSTGRES_DB=jurisprudence_hub
DB_USERNAME=postgres
DB_PASSWORD=ChangeMeInProduction_SecureDbPassword123!

# 3. JWT SECURITY
# BAT BUOC: Chuoi bi mat bat buoc dai >= 32 ky tu ngau nhien tren production
JWT_SECRET=SuperSecretKeyForJurisprudenceHubBackendProduction2026_AtLeast32Bytes!

# 4. CORS ORIGINS (Phan cach bang dau phay, KHONG co dau gach cheo cuoi cung)
CORS_ALLOWED_ORIGINS=https://jurisprudence.vn,https://app.jurisprudence.vn

# 5. EXAM HMAC SECRET
EXAM_HMAC_SECRET=SuperSecureExamHmacSecretKeyForJurisprudenceHub2026!

# 6. INITIAL ADMIN ACCOUNT
# Sau lan khoi tao dau tien tren production, co the set thanh false de tranh overwrite
APP_ADMIN_ENABLED=true
APP_ADMIN_EMAIL=admin@jurisprudence.vn
APP_ADMIN_PASSWORD=AdminSecurePassword2026!
APP_ADMIN_NAME=Quản Trị Viên Hệ Thống
APP_ADMIN_UNIT=Cục Đào tạo - Bộ Công An

# 7. FLYWAY DATABASE MIGRATION
FLYWAY_ENABLED=true
FLYWAY_CLEAN_DISABLED=true

# 8. JVM TUNING (Tuy chon)
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
